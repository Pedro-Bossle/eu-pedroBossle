{
  "functions": {
    "api/orcamentos.ts": {
      "maxDuration": 60
    }
  },
  "regions": [
    "gru1"
  ],
  "headers": [
    {
      "source": "/orcamentos/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/webhooks/pluggy",
      "destination": "/api/orcamentos"
    },
    {
      "source": "/webhooks/meta",
      "destination": "/api/orcamentos"
    },
    {
      "source": "/api/orcamentos/auth/me",
      "destination": "/api/orcamentos-auth-me"
    },
    {
      "source": "/api/orcamentos/auth/login",
      "destination": "/api/orcamentos-auth-login"
    },
    {
      "source": "/api/orcamentos/auth/logout",
      "destination": "/api/orcamentos-auth-logout"
    },
    {
      "source": "/api/orcamentos/auth/forgot-password",
      "destination": "/api/orcamentos-auth-forgot-password"
    },
    {
      "source": "/api/orcamentos/auth/reset-password",
      "destination": "/api/orcamentos-auth-reset-password"
    },
    {
      "source": "/api/orcamentos/(.*)",
      "destination": "/api/orcamentos"
    },
    {
      "source": "/((?!api/|@|src/|node_modules/|assets/)(?!.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/orcamentos/cron?tasks=daily",
      "schedule": "23 9 * * *"
    }
  ]
}
